        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "captions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 400,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "language": {
                    "type": "string"
                  },
                  "glossary": {
                    "type": "array",
