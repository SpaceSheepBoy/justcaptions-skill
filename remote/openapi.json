    "/transcribe": {
      "post": {
        "operationId": "post_transcribe",
        "summary": "Extracted audio to timed captions; max 12 MB decoded",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/vtt": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request"
          },
          "401": {
            "description": "invalid_api_key"
          },
          "402": {
            "description": "payment_required"
          },
          "429": {
            "description": "quota_exceeded, free_tier_busy, spend_cap_reached or rate_limited"
          },
          "503": {
            "description": "Provider or service unavailable"
          },
          "409": {
            "description": "idempotency_conflict or request_in_progress"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "audio_base64": {
                    "type": "string"
                  },
                  "mime_type": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "glossary": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string"
                    }
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "srt",
                      "vtt"
                    ],
                    "default": "json"
                  }
                },
                "required": [
                  "audio_base64"
                ]
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "language": {
                    "type": "string"
                  },
                  "glossary": {
                    "type": "string",
                    "description": "Comma-separated glossary terms"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "srt",
                      "vtt"
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            "description": "Reuse for identical retries within 24 hours. Different input with the same key returns 409."
          }
        ]
      }
    },
    "/correct": {
      "post": {
        "operationId": "post_correct",
        "summary": "Correct up to 400 captions / 80,000 input characters; keep count and order",
        "responses": {
